<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_margin="16dp">

    <LinearLayout
        android:id="@+id/boxpay_upi_alone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="Pay by any UPI App"
                android:layout_marginBottom="8dp"
                android:textSize="18sp"
                android:textColor="#020815"
                android:visibility="visible" />

            <ImageView
                android:id="@+id/upiLogo"
                android:src="@drawable/ic_boxpay_upi"
                android:layout_marginStart="4dp"
                android:layout_width="44dp"
                android:layout_height="26dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/upiOptionsLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/cardview_bg">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/popularUPIAppsConstraint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/PopularUPILinearLayout1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginBottom="10dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">


                    <ImageView
                        android:id="@+id/popularUPIImageView1"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/popular_item_unselected_bg"
                        android:padding="8dp"/>

                    <TextView
                        android:id="@+id/popularUPITextView1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:textColor="#595E6A" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/PopularUPILinearLayout2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="@+id/PopularUPILinearLayout1"
                    app:layout_constraintStart_toEndOf="@+id/PopularUPILinearLayout1"
                    app:layout_constraintTop_toTopOf="@+id/PopularUPILinearLayout1">

                    <ImageView
                        android:id="@+id/popularUPIImageView2"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/popular_item_unselected_bg"
                        android:padding="8dp"/>

                    <TextView
                        android:id="@+id/popularUPITextView2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:textColor="#595E6A" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/PopularUPILinearLayout3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="@+id/PopularUPILinearLayout2"
                    app:layout_constraintStart_toEndOf="@+id/PopularUPILinearLayout2"
                    app:layout_constraintTop_toTopOf="@+id/PopularUPILinearLayout2">

                    <ImageView
                        android:id="@+id/popularUPIImageView3"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/popular_item_unselected_bg"
                        android:padding="8dp"/>

                    <TextView
                        android:id="@+id/popularUPITextView3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:textColor="#595E6A" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/PopularUPILinearLayout4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="@+id/PopularUPILinearLayout3"
                    app:layout_constraintStart_toEndOf="@+id/PopularUPILinearLayout3"
                    app:layout_constraintTop_toTopOf="@+id/PopularUPILinearLayout3">

                    <ImageView
                        android:id="@+id/popularUPIImageView4"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/popular_item_unselected_bg"
                        android:padding="8dp"/>

                    <TextView
                        android:id="@+id/popularUPITextView4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:textColor="#595E6A" />
                </LinearLayout>


                <androidx.cardview.widget.CardView
                    android:id="@+id/proceedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="2dp"
                    android:clickable="true"
                    android:visibility="gone"
                    app:cardCornerRadius="7dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/PopularUPILinearLayout4">

                    <RelativeLayout
                        android:id="@+id/proceedButtonRelativeLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/button_bg"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/textView6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Pay ₹36,770 via GPay"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp" />

                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/addNewUPIIDConstraint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="6dp"
                android:visibility="visible">

                <View
                    android:id="@+id/dashedLine1"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@drawable/dashed_line"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/addNewUpiId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="20dp"
                    app:layout_constraintTop_toBottomOf="@+id/dashedLine1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:id="@+id/imageView15"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="10dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_boxpay_add" />

                    <TextView
                        android:id="@+id/textView26"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Add new UPI Id"
                        android:textColor="#1CA672"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="@+id/imageView15"
                        app:layout_constraintStart_toEndOf="@+id/imageView15"
                        app:layout_constraintTop_toTopOf="@+id/imageView15" />

                    <ImageView
                        android:id="@+id/imageView13"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        app:layout_constraintBottom_toBottomOf="@+id/textView26"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/textView26"
                        app:srcCompat="@drawable/ic_boxpay_checvron_down" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:id="@+id/addNewUpiTextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/addNewUpiId">

                    <TextView
                        android:id="@+id/cardCVVTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:gravity="center_vertical"
                        android:lineSpacingExtra="-1sp"
                        android:text="Enter UPI ID"
                        android:paddingStart="2dp"
                        android:textColor="#2D2B32" />

                    <EditText
                        android:id="@+id/addNewUpiTextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/edittext_bg"
                        android:fontFamily="@font/poppins"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:gravity="center_vertical"
                        android:hint="Enter UPI ID"
                        android:inputType="text"
                        android:paddingStart="12dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:textColor="#000000"
                        android:textColorHint="#7F7D83"
                        android:textSize="14sp"/>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/invalidCVV"
                        android:layout_width="wrap_content"
                        android:visibility="gone"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical|top">

                        <ImageView
                            android:id="@+id/imageView7"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="3dp"
                            android:src="@drawable/error_outline"
                            app:layout_constraintBottom_toBottomOf="@+id/textView8"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/textView8" />

                        <TextView
                            android:id="@+id/textView8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:fontFamily="@font/poppins"
                            android:gravity="center"
                            android:text="Please enter your UPI ID first"
                            android:textColor="#B9232F"
                            android:textSize="12sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/imageView7"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>


                <androidx.cardview.widget.CardView
                    android:id="@+id/addUpiIdProceedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="2dp"
                    android:clickable="true"
                    android:visibility="gone"
                    app:cardCornerRadius="7dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/addNewUpiTextInputLayout">

                    <RelativeLayout
                        android:id="@+id/addNewUpiProceedButtonRelativeLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/button_bg"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/addUpiIdTextView6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Pay ₹36,770 via GPay"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp" />

                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/boxpay_loader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/boxpayLogoLottie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="32dp"
            app:lottie_fileName="boxpayLogo.json" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/boxpayLogoLottie"
            android:layout_centerVertical="true"
            android:layout_centerHorizontal="true"
            android:paddingStart="6dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/poppins"
            android:text="Loading..."
            android:textColor="#4F4D55" />

        <!--                        app:lottie_autoPlay="true"-->

    </RelativeLayout>
</LinearLayout>