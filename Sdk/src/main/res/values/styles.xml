<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CustomDatePickerTheme" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <!-- Primary text color (Month/Year in header) -->
        <item name="android:textColorPrimary">#000000</item>

        <!-- Secondary text color (for hints) -->
        <item name="android:textColorSecondary">#666666</item>

        <!-- Year Selector color -->
        <item name="android:textColor">#000000</item>
        <item name="android:textColorTertiary">#000000</item>

        <!-- Header background (Month/Year bar) -->
        <item name="colorPrimary">#999999</item>
        <item name="colorPrimaryDark">#999999</item>
        <item name="colorAccent">#999999</item>
    </style>

    <style name="CustomCalendarTheme" parent="Widget.MaterialComponents.MaterialCalendar">
        <item name="android:background">#FFFFFF</item> <!-- Set calendar background to white -->
        <item name="colorOnSurface">#000000</item> <!-- Text color -->
        <item name="colorAccent">#FFFFFF</item> <!-- Accent color for the picker -->
        <item name="materialCalendarFullscreenTheme">@style/CalendarFullscreenTheme</item>
    </style>

    <style name="CalendarFullscreenTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:background">#FFFFFF</item> <!-- Fullscreen calendar background -->
    </style>
</resources>