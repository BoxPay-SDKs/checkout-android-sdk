<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CustomDatePickerTheme" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="colorAccent">#000000</item>
    </style>

    <style name="CustomCalendarTheme" parent="Widget.MaterialComponents.MaterialCalendar">
        <item name="android:background">#FFFFFF</item> <!-- Set calendar background to white -->
        <item name="colorOnSurface">#000000</item> <!-- Text color -->
        <item name="colorAccent">#FFFFFF</item> <!-- Accent color for the picker -->
        <item name="materialCalendarFullscreenTheme">@style/CalendarFullscreenTheme</item>
    </style>

    <style name="CalendarFullscreenTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:background">#FFFFFF</item> <!-- Fullscreen calendar background -->
    </style>
</resources>